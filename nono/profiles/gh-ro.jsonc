{
  "$schema": "../nono-profile.schema.json",
  "meta": {
    "name": "gh-ro"
  },
  "extends": [
    "gh-creds"
  ],
  "network": {
    "allow_domain": [
      {
        "domain": "api.github.com",
        "endpoints": [
          {
            "method": "GET",
            "path": "/**"
          },
          {
            "method": "HEAD",
            "path": "/**"
          }
        ]
      }
    ],
    "credentials": [
      "github"
    ],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}",
        "endpoint_rules": [
          {
            "method": "GET",
            "path": "/**"
          },
          {
            "method": "HEAD",
            "path": "/**"
          }
        ]
      }
    }
  }
}
