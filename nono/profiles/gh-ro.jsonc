{
  "$schema": "../nono-profile.schema.json",
  "meta": {
    "name": "gh-ro"
  },
  "network": {
    "allow_domain": [
      {
        "domain": "api.github.com",
        "endpoints": [
          {
            "method": "GET",
            "path": "/**"
          },
          {
            "method": "HEAD",
            "path": "/**"
          }
        ]
      }
    ],
    "credentials": [
      "github"
    ]
  }
}
