{
  "$schema": "../nono-profile.schema.json",
  "meta": {
    "name": "gh-rw"
  },
  "network": {
    "allow_domain": [
      {
        // L7 entry is needed to be composable with gh-ro profile
        "domain": "api.github.com",
        "endpoints": [
          {
            "method": "*",
            "path": "**"
          }
        ]
      },
      "github.com"
    ],
    "credentials": [
      "github",
      "github-git"
    ],
    "custom_credentials": {
      "github-git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github",
        "inject_mode": "basic_auth",
        "env_var": "GH_GOH",
        "credential_format": "x-access-token:{}",
        "endpoint_rules": [
          {
            "method": "GET",
            "path": "/acidghost/**"
          },
          {
            "method": "POST",
            "path": "/acidghost/**"
          }
        ]
      }
    },
    "tls_intercept": {
      "ca_lifecycle": "trusted"
    }
  },
  "filesystem": {
    "read": [
      "$XDG_CONFIG_HOME/gh",
      "$XDG_SHARE_HOME/gh",
      "$XDG_STATE_HOME/gh"
    ]
  }
}
