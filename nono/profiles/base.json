{
  "$schema": "../nono-profile.schema.json",
  "meta": {
    "name": "base"
  },
  "extends": [
    "default"
  ],
  "groups": {
    "include": [
      "git_config",
      "go_runtime",
      "mise_manager",
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" }
    ]
  },
  "filesystem": {
    "allow": [
      "~/.config/nono/profile-drafts",
      "~/go/pkg/mod/cache"
    ],
    "read": [
      "~/.agents",
      "~/.config/nono/packages",
      "~/.config/nono/profiles",
      "~/.dotfiles/agents",
      "~/.dotfiles/skills",
      "~/wa"
    ],
    "read_file": [
      "~/.gitconfig.private"
    ]
  },
  "network": {
    "allow_domain": [
      "bun.com",
      "hub.docker.com",
      "packages.ecosyste.ms",
      "api.scorecard.dev",
      "api.deps.dev"
    ]
  },
  "workdir": {
    "access": "readwrite"
  }
}
