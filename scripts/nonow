#!/usr/bin/env python3
import json
import os
import re
import sys


def main():
    args = sys.argv[1:]
    if not args or not args[0] or args[0].startswith("-"):
        print("usage: nonow <agent> [nono flags] [-- agent flags]", file=sys.stderr)
        return 2

    agent, *args = args
    separator = args.index("--") if "--" in args else len(args)
    flags = args[:separator]
    agent_args = args[separator + 1 :]
    names = {flag.split("=", 1)[0] for flag in flags}

    def has_flag(name: str, short_re: str) -> bool:
        return f"--{name}" in names or any(re.match(short_re, flag) for flag in flags)

    has_config = has_flag("config", r"^-[sv]*c")
    has_profile = has_flag("profile", r"^-[sv]*p")
    has_silent = has_flag("silent", r"^-v*s")

    nono_args = []
    if not has_config and not has_profile:
        nono_args.extend(["--profile", agent])
    if not has_config and "--allow-cwd" not in names and "--no-allow-cwd" not in flags:
        nono_args.append("--allow-cwd")
    if not has_silent and "--no-silent" not in flags:
        nono_args.append("--silent")

    nono_args.extend(
        flag for flag in flags if flag not in ("--no-allow-cwd", "--no-silent")
    )

    env = {**os.environ, "NONOW_NONO_ARGS": json.dumps(nono_args)}

    try:
        os.execvpe("nono", ["nono", "run", *nono_args, "--", agent, *agent_args], env)
    except OSError as error:
        print(f"nonow: {error}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
