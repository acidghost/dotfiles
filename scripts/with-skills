#!/usr/bin/env python3
"""Link skills permanently or for the lifecycle of a wrapped command."""

import fnmatch
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(os.path.realpath(__file__)).parent
SRC_ROOT = Path(os.environ.get("WITH_SKILLS_SRC", SCRIPT_DIR / "../skills")).resolve()
DEST_ROOT = Path(
    os.environ.get("WITH_SKILLS_DEST", os.path.expanduser("~/.agents/skills"))
)


def short_path(d: Path) -> str:
    """Relative path after the last 'skills/' segment, e.g. 'engineering/diagnose'."""
    parts = d.relative_to(SRC_ROOT).parts
    for i, p in enumerate(parts):
        if p == "skills" and i + 1 < len(parts):
            return str(Path(*parts[i + 1 :]))
    return str(Path(*parts))


def resolve_patterns(patterns: list[str]) -> list[Path]:
    """Match glob patterns against dirs under SRC_ROOT by basename or short path."""
    dirs = sorted(d for d in SRC_ROOT.rglob("*") if d.is_dir())
    matched: list[Path] = []
    for pattern in patterns:
        found = False
        for d in dirs:
            sp = short_path(d)
            if fnmatch.fnmatch(d.name, pattern) or fnmatch.fnmatch(sp, pattern):
                if d not in matched:
                    matched.append(d)
                found = True
        if not found:
            print(f"warning: no match for '{pattern}'", file=sys.stderr)
    return matched


def link(src: Path, *, replace_symlink: bool = False) -> bool:
    """Link a directory, backing up displaced entries. Return whether a link was made."""
    name = src.name
    dest = DEST_ROOT / name
    backup = dest.with_name(f".{name}.bak")

    if dest.is_symlink():
        if dest.resolve() == src.resolve():
            return False
        if not replace_symlink:
            raise FileExistsError(f"refusing to replace unrelated symlink: {dest}")

    dest.parent.mkdir(parents=True, exist_ok=True)
    backed_up = False
    if dest.exists() or dest.is_symlink():
        if backup.exists() or backup.is_symlink():
            raise FileExistsError(f"backup already exists: {backup}")
        dest.rename(backup)
        backed_up = True

    try:
        dest.symlink_to(src)
    except OSError:
        if backed_up:
            backup.rename(dest)
        raise

    print(f"linked: {name}")
    return True


def unlink(src: Path, *, restore_backup: bool = True) -> None:
    """Remove this source's link and restore its on-disk backup, if any."""
    name = src.name
    dest = DEST_ROOT / name
    backup = dest.with_name(f".{name}.bak")
    if not dest.is_symlink():
        return
    if dest.resolve() != src.resolve():
        raise FileExistsError(f"refusing to remove unrelated symlink: {dest}")

    dest.unlink()
    print(f"unlinked: {name}")
    if restore_backup and (backup.exists() or backup.is_symlink()):
        backup.rename(dest)
        print(f"restored: {name}")


def run_wrapped(skills: list[Path], command: list[str]) -> int:
    """Run with temporary links, undoing only changes made by this invocation."""
    linked: list[tuple[Path, bool]] = []
    exit_code = 0
    try:
        for skill in skills:
            dest = DEST_ROOT / skill.name
            displaced = dest.exists() or dest.is_symlink()
            if link(skill, replace_symlink=True):
                linked.append((skill, displaced))
        exit_code = subprocess.call(command)
    except OSError as e:
        print(f"error: {e}", file=sys.stderr)
        exit_code = 1
    except KeyboardInterrupt:
        exit_code = 130
    finally:
        for skill, displaced in reversed(linked):
            try:
                unlink(skill, restore_backup=displaced)
            except OSError as e:
                print(f"error unlinking {skill.name}: {e}", file=sys.stderr)
                exit_code = exit_code or 1
    return exit_code


def print_help() -> None:
    print("""\
usage: with-skills <pattern>... -- <command> [args...]
       with-skills {link,unlink} <pattern>...

Link skills for a command's lifecycle, or permanently link/unlink dirs in ~/.agents/skills/.

  pattern   glob matched against dir names or paths after 'skills/'
  --        separator between patterns and command
  -h, --help  show this help message

Examples:
    with-skills grill-me -- pi
    with-skills 'engineering/*' 'productivity/*' -- pi
    with-skills link grill-me
    with-skills unlink grill-me

Existing entries are backed up as .<name>.bak and restored on unlink.
WITH_SKILLS_SRC and WITH_SKILLS_DEST override the source and destination.
""")


def main() -> None:
    argv = sys.argv[1:]
    # Only interpret help flags before the separator, not in the wrapped command.
    option_args = argv[: argv.index("--")] if "--" in argv else argv
    if not argv or any(arg in ("-h", "--help") for arg in option_args):
        print_help()
        sys.exit(0 if argv else 1)

    command = None
    if "--" in argv:
        # The separator takes precedence: even 'link'/'unlink' can be skill names.
        sep = argv.index("--")
        patterns, command = argv[:sep], argv[sep + 1 :]
        action = "run"
    elif argv[0] in ("link", "unlink"):
        action, patterns = argv[0], argv[1:]
    else:
        print(
            "error: missing -- separator before command (or use link/unlink)",
            file=sys.stderr,
        )
        sys.exit(1)

    if not patterns:
        print("error: no patterns specified", file=sys.stderr)
        sys.exit(1)
    if command is not None and not command:
        print("error: no command specified after --", file=sys.stderr)
        sys.exit(1)

    skills = resolve_patterns(patterns)
    if not skills:
        print("error: no dirs matched", file=sys.stderr)
        sys.exit(1)

    if command is not None:
        sys.exit(run_wrapped(skills, command))

    operation = link if action == "link" else unlink
    exit_code = 0
    for skill in skills:
        try:
            operation(skill)
        except OSError as e:
            print(f"error {action}ing {skill.name}: {e}", file=sys.stderr)
            exit_code = 1

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
