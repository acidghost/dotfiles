{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>acidghost/renovate-config",
    "local>acidghost/renovate-config:mise-biome"
  ],
  "schedule": [
    "* 0-6 * * 6"
  ],
  "commitMessageAction": "",
  "commitMessageTopic": "{{depName}}",
  "ignoreDeps": [
    "ble.sh",
    "dotbot"
  ],
  "git-submodules": {
    "enabled": true
  },
  "mise": {
    "commitMessagePrefix": "[mise]"
  },
  "packageRules": [
    {
      "matchDepNames": [
        "biome"
      ],
      "commitMessagePrefix": "[mise]"
    },
    {
      "matchDepNames": [
        "pi"
      ],
      "minimumReleaseAge": "1d"
    },
    {
      "matchFileNames": [
        "/^pi/.+$/"
      ],
      "commitMessagePrefix": "[pi]"
    }
  ]
}
