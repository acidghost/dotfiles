{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>acidghost/renovate-config",
    "local>acidghost/renovate-config:mise-biome"
  ],
  "schedule": [
    "* 0-6 * * 6"
  ],
  "commitMessageAction": "",
  "commitMessageTopic": "{{depName}}",
  "ignoreDeps": [
    "ble.sh",
    "dotbot"
  ],
  "git-submodules": {
    "enabled": true
  },
  "mise": {
    "commitMessagePrefix": "[mise]"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tag-pinned zsh plugins in antidote plugins.txt",
      "managerFilePatterns": [
        "/^zsh\\/plugins\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w.-]+/[\\w.-]+)[^\\n#]*?\\s*pin:(?<currentDigest>[0-9a-f]{40})\\s#\\s((?<currentValue>v?\\d[\\w.+]*)|HEAD)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "biome"
      ],
      "commitMessagePrefix": "[mise]"
    },
    {
      "matchDepNames": [
        "@earendil-works/pi-coding-agent",
        "pi"
      ],
      "minimumReleaseAge": "1d"
    },
    {
      "matchFileNames": [
        "/^pi/.+$/"
      ],
      "commitMessagePrefix": "[pi]"
    },
    {
      "matchDepNames": [
        "@earendil-works/pi-coding-agent",
        "pi"
      ],
      "groupName": "pi-coding-agent"
    },
    {
      "matchFileNames": [
        "zsh/plugins.txt"
      ],
      "commitMessagePrefix": "[zsh]"
    },
    {
      "description": "Merge once smoke CI is green",
      "matchManagers": ["mise", "git-submodules", "bun"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
